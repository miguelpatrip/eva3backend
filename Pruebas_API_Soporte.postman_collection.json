          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({\n    url: 'http://127.0.0.1:8000/api-auth/login/',\n    method: 'GET'\n}, function (err, res, { cookies }) {\n    if (!err) {\n        const csrfToken = cookies.get('csrftoken');\n        if (csrfToken) {\n            pm.collectionVariables.set('csrfToken', csrfToken);\n        }\n    }\n});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.globals.set(\"csrftoken\", pm.cookies.get(\"csrftoken\"));"
            ]
          }
        }
